solid octahedron
  facet normal 1 1 1
    outer loop
      vertex 2 0 0
      vertex 0 2 0
      vertex 0 0 2
    endloop
  endfacet
  facet normal 1 1 -1
    outer loop
      vertex 2 0 0
      vertex 0 0 -2
      vertex 0 2 0
    endloop
  endfacet
  facet normal 1 -1 1
    outer loop
      vertex 2 0 0
      vertex 0 0 2
      vertex 0 -2 0
    endloop
  endfacet
  facet normal 1 -1 -1
    outer loop
      vertex 2 0 0
      vertex 0 -2 0
      vertex 0 0 -2
    endloop
  endfacet
  facet normal -1 1 1
    outer loop
      vertex -2 0 0
      vertex 0 0 2
      vertex 0 2 0
    endloop
  endfacet
  facet normal -1 1 -1
    outer loop
      vertex -2 0 0
      vertex 0 2 0
      vertex 0 0 -2
    endloop
  endfacet
  facet normal -1 -1 1
    outer loop
      vertex -2 0 0
      vertex 0 -2 0
      vertex 0 0 2
    endloop
  endfacet
  facet normal -1 -1 -1
    outer loop
      vertex -2 0 0
      vertex 0 0 -2
      vertex 0 -2 0
    endloop
  endfacet
endsolid octahedron
